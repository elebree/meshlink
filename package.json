{
  "name": "meshtastic-link-decoder",
  "private": false,
  "version": "1.2.0",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "author": {
    "name": "elebree"
  },
  "homepage": "https://elebree.github.io/meshlink/",
  "description": "This tool decodes Meshtastic links and extracts the contact or channel information.",
  "license": "MIT",
  "keywords": [
    "meshtastic"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "protogen": "buf generate",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.70.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.1",
    "@types/prismjs": "^1.26.6",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4"
  }
}
